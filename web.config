<?xml version="1.0" encoding="UTF-8"?>
<configuration>
<system.web>
        <customErrors mode="Off"/>
		<pages validateRequest="false" />

		<httpRuntime requestPathInvalidCharacters="" requestValidationMode="2.0" />
    </system.web>
	
    <system.webServer>
        <rewrite>
            <rules>
        <rule name="Redirect legacy domains to 3PhaseFlow" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(www\.)?(motorswinding|iqmotorbase)\.com$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://3phaseflow.com/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
		<rule name="Redirect to https" stopProcessing="true">
          <match url=".*"/>
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true"/>
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Permanent" appendQueryString="false"/>
        </rule>
			<rule name="ReverseProxyInboundRule1" stopProcessing="true">		
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://localhost:5066/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>