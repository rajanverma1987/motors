# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/dev/node_modules
/node_modules
/dev/vendor/**/node_modules
/dev/vendor/**/package-lock.json
vendor/**/node_modules
vendor/**/package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/dev/.next/
/.next/
/dev/out/
/out/

# production
/build

# misc
.DS_Store
*.pem

# project docs (not for repo)
/dev/documents
/documents

# uploaded listing photos
/dev/public/uploads
/public/uploads

# per-shop upload roots (multi-host)
/shop_uploads/**
!/shop_uploads/.gitkeep
!/shop_uploads/**/.gitkeep

# per-app installs / builds
/apps/*/node_modules
/apps/*/.next
/clients/*/node_modules
/clients/*/.next
/clients/*/.env
/apps/*/.env

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Google Cloud / Search Console service account keys (never commit)
**/gsc-*.json
gsc-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
