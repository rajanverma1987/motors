{
  "name": "iqwirecalculator",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "EXPO_PUBLIC_API_URL=https://iqmotorbase.com expo start",
    "android": "EXPO_PUBLIC_API_URL=https://iqmotorbase.com expo run:android",
    "ios": "EXPO_PUBLIC_API_URL=https://iqmotorbase.com expo run:ios",
    "release:preview:android": "eas build --platform android --profile preview",
    "release:preview:ios": "eas build --platform ios --profile preview",
    "release:preview:all": "eas build --platform all --profile preview",
    "release:build:android": "eas build --platform android --profile production",
    "release:build:ios": "eas build --platform ios --profile production",
    "release:build:all": "eas build --platform all --profile production",
    "release:submit:android": "eas submit --platform android --latest --profile production",
    "release:submit:ios": "eas submit --platform ios --latest --profile production",
    "release:store": "node scripts/release-store.js",
    "release:ota": "node scripts/eas-update-with-prod-api-url.js --channel production",
    "release:preview": "node scripts/eas-update-with-prod-api-url.js --channel preview --message IQWireCalculator-preview-Expo-Go"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-iap": "^5.3.1",
    "expo-mail-composer": "~15.0.8",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0"
  },
  "private": true,
  "overrides": {
    "expo-font": "~14.0.12"
  }
}
